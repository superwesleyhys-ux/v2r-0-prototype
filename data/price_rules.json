{
  "currency": "USD",
  "rules": {
    "material_cost_per_gram": 0.035,
    "machine_hourly_rate": 2.5,
    "labor_hourly_rate": 15,
    "default_shipping_cost": 5.5,
    "default_platform_fee_rate": 0.12,
    "default_rework_risk_rate": 0.08
  },
  "quote_formula": [
    "material = materialGrams * materialCostPerGram",
    "machine = printHours * machineHourlyRate",
    "labor = laborMinutes / 60 * laborHourlyRate",
    "base = manufacturing + standardPartsCost + packagingCost + shippingCost",
    "final = base + tax + platformFee + reworkReserve"
  ]
}
